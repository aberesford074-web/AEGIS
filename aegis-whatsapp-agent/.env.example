PORT=8787
PUBLIC_BASE_URL=https://your-public-url.example.com

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google OAuth for Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# For first test, leave this as the Twilio WhatsApp sandbox sender.
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
# This must be your personal WhatsApp number in E.164 format with whatsapp: prefix.
OWNER_WHATSAPP_TO=whatsapp:+447000000000
# Alternative if you prefer not to include the whatsapp: prefix:
OWNER_PHONE_NUMBER=+447000000000

# App behaviour
AGENT_DISPLAY_NAME=Aegis Agent
MAX_EMAILS_PER_CHECK=5
STORE_PATH=./data/store.default.json
DIGEST_ENABLED=false
DIGEST_INTERVAL_MINUTES=60
DIGEST_STARTUP_SCAN=false
