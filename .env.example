# Safe example configuration for the WhatsApp email-agent prototype.
# Copy this file to aegis-whatsapp-agent/.env and replace placeholders locally.
# Never commit the completed .env file.

PROFILE=example
PORT=8787
PUBLIC_BASE_URL=https://your-public-url.example.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Google OAuth for Gmail
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
OWNER_WHATSAPP_TO=whatsapp:+44XXXXXXXXXX

# App behaviour
AGENT_DISPLAY_NAME=AEGIS Agent
MAX_EMAILS_PER_CHECK=5
STORE_PATH=./data/store.example.json
DIGEST_ENABLED=false
DIGEST_INTERVAL_MINUTES=60
DIGEST_STARTUP_SCAN=false
